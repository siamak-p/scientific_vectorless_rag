# Scientific RAG - example environment file.
# Copy to ".env" and fill in only the providers you actually use.
# Every value here is optional: keys can also be entered in the Settings page.

# --- Cloud LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Local LLM runtimes (defaults shown) ---
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Scientific search ---
# Tavily is the only search provider that requires a key.
TAVILY_API_KEY=
# Optional: raises the Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=
# Recommended by OpenAlex, Crossref and PubMed for the polite request pool.
SCIENTIFIC_RAG_CONTACT_EMAIL=

# --- Storage ---
# Overrides where settings, the database, caches and exports are written.
# Default: %LOCALAPPDATA%\ScientificRAG on Windows, ~/.scientific_rag on Linux,
# ~/Library/Application Support/ScientificRAG on macOS.
SCIENTIFIC_RAG_HOME=
